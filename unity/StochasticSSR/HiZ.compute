#pragma kernel ReduceDepth
#pragma kernel Trace
#pragma kernel FinalizeContinuedSky
#pragma target 5.0
#pragma multi_compile_local _ FTFX_LATE_RASTER
#pragma multi_compile_local _ FTFX_TRACE_DIAGNOSTICS
#pragma multi_compile_local _ FTFX_REJECTION_DIAGNOSTICS
#pragma multi_compile_local _ FTFX_TRAVERSAL_DIAGNOSTICS
#if defined(FTFX_TRACE_DIAGNOSTICS) && defined(FTFX_TRAVERSAL_DIAGNOSTICS)
#define FTFX_WORK
#endif
#define FTFX_COMPUTE_RASTER
Texture2D<float> _DepthPrevious;
RWTexture2D<float> _DepthOutput;
Texture2D<float> _HiZ0,_HiZ1,_HiZ2,_HiZ3,_HiZ4,_HiZ5,_HiZ6,_HiZ7,_HiZ8,_HiZ9,_HiZ10,_HiZ11,_HiZ12,_HiZ13;
Texture2D<float4> _Normals,_Specular,_Scene;
RWTexture2D<float4> _RadianceOutput,_HitOutput,_PointOutput,_RecordOutput;
int _ZeroSmoothnessProbe;
RWTexture2D<float4> _TraceInfo;
#if defined(FTFX_REJECTION_DIAGNOSTICS)
RWTexture2D<float4> _TraceStop;
#endif
#if defined(FTFX_TRACE_DIAGNOSTICS)
RWTexture2D<float4> _DepthHit;
#endif
float4x4 _Projection,_InverseProjection,_WorldToView;
float4 _Size,_Trace,_Clip;
// _Trace.x and _Clip.w are unused.
float _EdgePixels;
int _Frame;
float _ThicknessConfidenceFloor;
int _EndpointSkyFallback;
float4 _Continuation; // total skipped cells, major-axis camera pixels, eye-depth gap, unused
#include "AMD/Sampling.hlsl"
#if defined(FTFX_TRACE_DIAGNOSTICS)
#include "ReuseBrdf.hlsl"
#endif
#include "RasterState.hlsl"
static float4x4 rasterProjection,rasterInverse,rasterView;
void LoadRasterMatrices() {
    rasterProjection=SsrRasterMatrix(_Projection,0);rasterInverse=SsrRasterMatrix(_InverseProjection,4);rasterView=SsrRasterMatrix(_WorldToView,12);
}
#if defined(FTFX_TRACE_DIAGNOSTICS)
RWTexture2D<float4> _SampleOutput;
#endif
// Reuse the two diagnostic UAV slots: DX11 SM5 allows eight, and the
// five ordinary outputs are rendering state. First rejection is optional;
// work capture replaces ray/PDF and accepted-depth diagnostics for one frame.
#if defined(FTFX_WORK)
static uint workIterations,workContinuation,workDescents,workFine,workLevels,workRepeated,workEligible,workRejected;
static int2 workLastFine;
#endif
void StoreTraversal(uint2 pixel) {
#if defined(FTFX_WORK)
    _SampleOutput[pixel]=float4(workIterations,workContinuation,workDescents,workEligible);
    _DepthHit[pixel]=float4(workFine,workLevels,workRepeated,workRejected);
#endif
}
Texture2D<float2> _WaterSurface;
float3 Position(float2 uv,float depth)
{
    float4 h=mul(rasterInverse,float4(uv*2-1,depth,1));
    return h.xyz/h.w;
}

[numthreads(8,8,1)]
void ReduceDepth(uint3 id:SV_DispatchThreadID)
{
    uint w,h,pw,ph; _DepthOutput.GetDimensions(w,h);_DepthPrevious.GetDimensions(pw,ph);
    if(id.x>=w || id.y>=h)return;
    int2 p=id.xy*2, hi=int2(pw,ph)-1;
    _DepthOutput[id.xy]=min(min(_DepthPrevious.Load(int3(min(p,hi),0)),_DepthPrevious.Load(int3(min(p+int2(1,0),hi),0))),
        min(_DepthPrevious.Load(int3(min(p+int2(0,1),hi),0)),_DepthPrevious.Load(int3(min(p+1,hi),0))));
}
float SceneDepth(int2 p,int mip)
{
    switch(mip) {
        case 0:return _HiZ0.Load(int3(p,0));case 1:return _HiZ1.Load(int3(p,0));
        case 2:return _HiZ2.Load(int3(p,0));case 3:return _HiZ3.Load(int3(p,0));
        case 4:return _HiZ4.Load(int3(p,0));case 5:return _HiZ5.Load(int3(p,0));
        case 6:return _HiZ6.Load(int3(p,0));case 7:return _HiZ7.Load(int3(p,0));
        case 8:return _HiZ8.Load(int3(p,0));case 9:return _HiZ9.Load(int3(p,0));
        case 10:return _HiZ10.Load(int3(p,0));case 11:return _HiZ11.Load(int3(p,0));
        case 12:return _HiZ12.Load(int3(p,0));default:return _HiZ13.Load(int3(p,0));
    }
}
float2 OctEncode(float3 n)
{
    n/=max(abs(n.x)+abs(n.y)+abs(n.z),.00001);
    float2 s=float2(n.x>=0?1:-1,n.y>=0?1:-1);
    return n.z>=0?n.xy:(1-abs(n.yx))*s;
}
float2 Project(float3 p)
{
    float4 h=mul(rasterProjection,float4(p,1));return h.xy/h.w*.5+.5;
}
float PlaneExit(float inside,float slope)
{
    return slope<0?max(0,-inside/slope):1e20;
}
// Miss-only record.z: 0 excluded, 1 invalid normal, 2 GGX hemisphere,
// 3 short/degenerate ray, 4 self hit, 5 hit facing, 6 frustum exit,
// 8 traversal budget, 9 unresolved depth, 10 completed/unconfirmed background.
// Historical reason 7 was hit-distance rejection and is no longer emitted.
// record.w retains the existing source classification contract.
void TraceReason(uint2 pixel,float reason,float kind,float4 stats)
{
    _RecordOutput[pixel]=float4(0,0,reason,kind);
    _TraceInfo[pixel]=stats;
    StoreTraversal(pixel);
}
// Diagnostics record attempted cost on failure, consumed cost on recovery.
// Flags: 1 foreground depth, 2 facing, 4 recovered, 8 allowance exhausted,
// 16 accepted low-facing confidence-only hit, 32 initial self-contact candidate,
// 64 sky after completed bounded continuation (not recovered geometry),
// 128 endpoint-validated sky fallback after failed foreground continuation.
// The first rejection is retained. Bit 32 never changes trace acceptance.
bool ContinueRejected(uint2 pixel,float2 uv,float rayDepth,float surface,float span,int cause,inout float4 stats)
{
#if defined(FTFX_WORK)
    workRejected++;
#endif
#if defined(FTFX_REJECTION_DIAGNOSTICS)
    if(stats.w==0)_TraceStop[pixel]=float4(uv,rayDepth,surface);
#endif
    stats.xyz=float3(stats.x+1,stats.y+span,max(stats.z,max(0,rayDepth-surface)));
    stats.w=(int)stats.w | cause;
    bool allowed=_Continuation.x>0 && stats.x<=_Continuation.x && stats.y<=_Continuation.y && stats.z<=_Continuation.z;
    if(!allowed && _Continuation.x>0)stats.w=(int)stats.w | 8;
    return allowed;
}
// The water producer supplies surface depth, not the opaque bed underneath it.
// Require agreement with the depth actually used by this trace.
bool WaterPosition(int2 pixel,out float3 position)
{
    position=0;
    if(any(pixel<0) || any(pixel>=(int2)_Size.xy))return false;
    float z=_WaterSurface.Load(int3(pixel,0)).x,scene=_HiZ0.Load(int3(pixel,0));
    if(!isfinite(z) || z<=0 || z>=_Clip.y || abs(z-scene)>max(.005,scene*.0001))return false;
    float3 ray=Position((pixel+.5)/_Size.xy,.5);
    position=ray*(z/-ray.z);return all(isfinite(position));
}
[numthreads(8,8,1)]
void Trace(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=(uint2)_Size.zw))return;
#if defined(FTFX_WORK)
    workIterations=workContinuation=workDescents=workFine=workLevels=workRepeated=workEligible=workRejected=0;
    workLastFine=int2(-1,-1);
#endif
    float4 stats=0;
    _TraceInfo[id.xy]=0;
#if defined(FTFX_REJECTION_DIAGNOSTICS)
    _TraceStop[id.xy]=0;
#endif
#if defined(FTFX_TRACE_DIAGNOSTICS)
    _DepthHit[id.xy]=0;_SampleOutput[id.xy]=0;
#endif
    float2 uv=(id.xy+.5)/_Size.zw;
    int2 pixel=min((int2)(uv*_Size.xy),(int2)_Size.xy-1);
    float4 encodedNormal=_Normals.Load(int3(pixel,0));
    float3 normal=encodedNormal.xyz*2-1;
    float smoothness=_Specular.Load(int3(pixel,0)).a;
    float depth=SceneDepth(pixel,0);
    normal*=rsqrt(max(dot(normal,normal),1e-12));
    _RadianceOutput[id.xy]=0;_RecordOutput[id.xy]=0;_HitOutput[id.xy]=float4(0,depth,OctEncode(normal));_PointOutput[id.xy]=float4(0,0,0,smoothness);
    if(smoothness<_Trace.z || depth<=_Clip.x || depth>=_Clip.y*.999)return;
    if(all(encodedNormal==0) || dot(encodedNormal.xyz*2-1,encodedNormal.xyz*2-1)<1e-8) {TraceReason(id.xy,1,0,stats);return;}
    // Probe-only receivers retain their guides but never enter GGX or traversal.
    // Reflected source sampling and the original material G-buffer stay intact.
    if(_ZeroSmoothnessProbe!=0 && smoothness==0 && any(_Specular.Load(int3(pixel,0)).rgb!=0))return;
#if defined(FTFX_WORK)
    workEligible=1;
#endif

    // Ineligible receivers need their guides, but no late raster matrix reads.
    LoadRasterMatrices();
    float3 p=Position((pixel+.5)/_Size.xy,.5);
    p*=depth/(-p.z);
    // Receiver guides retain the original material normal. This prototype does
    // not weaken history/upsampling identity tests or change source-hit normals.
    float3 traceNormal=normal;

    float3 n=normalize(mul((float3x3)rasterView,traceNormal));
    float3 direction=reflect(normalize(p),n);
    float visibility=1;
    if(smoothness<1)
    {
        float alpha=(1-smoothness)*(1-smoothness);
        if(dot(-normalize(p),n)<=0) {TraceReason(id.xy,2,-1,stats);return;}
        direction=SampleReflectionVector(normalize(p),n,alpha,id.xy);
        float cosine=dot(n,direction);
        if(cosine<=0) {TraceReason(id.xy,2,-1,stats);return;}
        // Separable Smith G2/G1; FTFX applies EFT's normalized material response.
        visibility=2*cosine/(cosine+sqrt(alpha*alpha+(1-alpha*alpha)*cosine*cosine));
    }
    _PointOutput[id.xy]=float4(direction,smoothness);
#if defined(FTFX_TRACE_DIAGNOSTICS) && !defined(FTFX_WORK)
    _SampleOutput[id.xy]=float4(direction,(smoothness<1)?ReusePdf(-normalize(p),n,direction,smoothness):0);
#endif
    float3 start=p;
    if(start.z>=-_Clip.x) {TraceReason(id.xy,3,-1,stats);return;}
    float farDistance=direction.z<0?(-_Clip.y-start.z)/direction.z:1e20;
    float nearDistance=direction.z>0?(-_Clip.x-start.z)/direction.z:1e20;
    float4 originClip=mul(rasterProjection,float4(start,1));
    float4 rayClip=mul(rasterProjection,float4(direction,0));
    float sideDistance=min(min(PlaneExit(originClip.w+originClip.x,rayClip.w+rayClip.x),
                               PlaneExit(originClip.w-originClip.x,rayClip.w-rayClip.x)),
                           min(PlaneExit(originClip.w+originClip.y,rayClip.w+rayClip.y),
                               PlaneExit(originClip.w-originClip.y,rayClip.w-rayClip.y)));
    float boundaryDistance=min(farDistance,min(nearDistance,sideDistance));
    // Eligible receivers trace to the frustum boundary without a hit-distance cap.
    float distance=boundaryDistance;
    bool farExit=farDistance<=min(nearDistance,sideDistance);
    if(distance<=.05) {TraceReason(id.xy,3,-1,stats);return;}
    float3 finish=start+direction*distance;
    float2 a=Project(start), b=Project(finish), delta=b-a;
    float pixels=max(abs(delta.x)*_Size.x,abs(delta.y)*_Size.y);
    if(pixels<2 || any(a<=0) || any(a>=1)) {TraceReason(id.xy,3,-1,stats);return;}
    float epsilon=.005/pixels;
    float t=1.5/pixels;
    float2 edge=float2(delta.x>=0?1:0,delta.y>=0?1:0);
    float2 invDelta=float2(abs(delta.x)>1e-8?1/delta.x:1e20,abs(delta.y)>1e-8?1/delta.y:1e20);
    float limit=1;
    if(abs(delta.x)>1e-8)limit=min(limit,(edge.x-a.x)*invDelta.x);
    if(abs(delta.y)>1e-8)limit=min(limit,(edge.y-a.y)*invDelta.y);
    float iz0=1/(-start.z), iz1=1/(-finish.z);
    int mip=0;
    bool leftScreen=false;
    // Relaxed return acceptance is fixed on. The former predicate
    // (rearmed || stats.x>0) was invariant: rearmed began true and was only
    // cleared after ContinueRejected incremented stats.x. No rearm state is
    // needed; the bounded depth and self-hit checks remain.
    // Mip descent retains t: keep its UV and start depth until advancing.
    float2 current=a+delta*t;
    float z0=1/lerp(iz0,iz1,t);
    [loop] for(int iteration=0;iteration<(int)_Trace.w && t<limit;iteration++)
    {
#if defined(FTFX_WORK)
        workIterations++;if(stats.x>0)workContinuation++;
#endif
        if(any(current<=0) || any(current>=1)) {leftScreen=true;break;}
        int2 cell;float next;
        {
            // Supported mip levels are 0..13. Construct an exact power of two.
            float cellSize=asfloat(0x3f800000u+((uint)mip<<23));
            cell=(int2)floor(current*_Size.xy/cellSize);
            float2 boundary=(cell+edge)*cellSize/_Size.xy;
            float2 crossings=(boundary-a)*invDelta;
            if(abs(delta.x)<=1e-8)crossings.x=1e20;
            if(abs(delta.y)<=1e-8)crossings.y=1e20;
            next=min(limit,min(crossings.x,crossings.y));
            next=max(next,t+epsilon);
        }
        float z1=1/lerp(iz0,iz1,next);
        float surface=SceneDepth(cell,mip);
#if defined(FTFX_WORK)
        workLevels|=1u<<mip;
        if(mip==0) {workFine++;if(all(cell==workLastFine))workRepeated++;workLastFine=cell;}
#endif
        if(max(z0,z1)<surface-.001)
        {
            t=next+epsilon;current=a+delta*t;z0=1/lerp(iz0,iz1,t);
            mip=min(mip+1,(int)_Clip.z);
            continue;
        }
        if(mip>0) {
#if defined(FTFX_WORK)
            workDescents++;
#endif
            mip--;continue;
        }
        if(surface<_Clip.y*.999 && min(z0,z1)<=surface+_Trace.y && max(z0,z1)>=surface)
        {
            float hitT=abs(iz1-iz0)>1e-9?(1/surface-iz0)/(iz1-iz0):t;
            bool bracketed=min(z0,z1)<=surface && max(z0,z1)>=surface;
            hitT=clamp(hitT,t,next);
            float2 hitUv=a+delta*hitT;
            int2 hitPixel=clamp((int2)(hitUv*_Size.xy),0,(int2)_Size.xy-1);
#if defined(FTFX_TRACE_DIAGNOSTICS) && !defined(FTFX_WORK)
            bool crossedCell=any(hitPixel!=cell);
#endif
            // A root clamped to a cell's exit boundary can round into its
            // neighbour. Depth acceptance above belongs to cell, not that
            // neighbour. The accepted source UV is retained unchanged.
            float separation=length((hitUv-uv)*_Size.xy);
            // Hit-normal rejection and weighting are permanently bypassed.
            // The bounded depth intersection and self-hit separation still
            // apply; unrelated behind-depth samples cannot become hits.
            // Self intersections remain terminal, including after a continued gap.
            if(separation<2) {
                // Preserve the rejected trace and its initial-contact record.
                if(iteration==0 && stats.w==0) {
                    stats=float4(0,0,0,32);
#if defined(FTFX_REJECTION_DIAGNOSTICS)
                    _TraceStop[id.xy]=float4(hitUv,1/lerp(iz0,iz1,hitT),surface);
#endif
                }
                TraceReason(id.xy,4,-1,stats);return;
            }
            {
                float2 border=min(hitUv,1-hitUv)*_Size.xy;
                float edgeConfidence=_EdgePixels>0?saturate(min(border.x,border.y)/_EdgePixels):1;
                float normalConfidence=1;
                float confidence=edgeConfidence*normalConfidence;
                float residual=max(0,1/lerp(iz0,iz1,hitT)-surface);
                float depthConfidence=saturate(1-residual/max(_Trace.y,.001));
                // Diagnostic response control for already accepted thickness-
                // only hits. Zero preserves the original weighting. This never
                // accepts a previously rejected depth/self candidate.
                confidence*=bracketed?depthConfidence:lerp(depthConfidence,1,saturate(_ThicknessConfidenceFloor));
#if defined(FTFX_TRACE_DIAGNOSTICS) && !defined(FTFX_WORK)
                _DepthHit[id.xy]=float4((bracketed?1:2)+(crossedCell?4:0),depthConfidence,normalConfidence,edgeConfidence);
#endif
                _RadianceOutput[id.xy]=float4(max(_Scene.Load(int3(hitPixel,0)).rgb,0),visibility);

                {
                    _HitOutput[id.xy]=float4(confidence,depth,OctEncode(normal));
                    float3 hitPosition=Position(hitUv,.5);hitPosition*=surface/(-hitPosition.z);
                    _PointOutput[id.xy]=float4(hitPosition,smoothness);
                }
                // UV, traversal fraction, source classification. Coverage is separate.
                _RecordOutput[id.xy]=float4(hitPixel,(iteration+1)/_Trace.w,1);
                if(stats.x>0)stats.w=(int)stats.w | 4;
                _TraceInfo[id.xy]=stats;
                StoreTraversal(id.xy);
                return;
            }

        }
        // Bounded traversal through unknown foreground depth does not widen hit thickness.
        // Zero allowance preserves the previous immediate unresolved return.
        if(surface<_Clip.y*.999 && max(z0,z1)>=surface) {
            if(!ContinueRejected(id.xy,current,max(z0,z1),surface,(next+epsilon-t)*pixels,1,stats)) {
                TraceReason(id.xy,_Continuation.x>0?11:9,0,stats);return;
            }
        }
        t=next+epsilon;current=a+delta*t;z0=1/lerp(iz0,iz1,t);mip=0;
    }
    // Only a completed, in-frustum traversal to the far plane with background
    // at its endpoint can establish sky. Offscreen, budget and blocked geometry misses cannot.
    if(stats.x==0 && farExit && t>=1 && limit>=1 &&
        all(b>0) && all(b<1) && SceneDepth((int2)(b*_Size.xy),0)>=_Clip.y*.999)
    {
        float2 border=min(b,1-b)*_Size.xy;
        float c=_EdgePixels>0?saturate(min(border.x,border.y)/_EdgePixels):1;
        _HitOutput[id.xy]=float4(c,depth,OctEncode(normal));
        _PointOutput[id.xy]=float4(direction,smoothness);
        _RadianceOutput[id.xy]=float4(0,0,0,visibility);
        _RecordOutput[id.xy]=float4(b,distance,2);
        StoreTraversal(id.xy);
        return;
    }
    // Report the terminal cause without changing any tracing/sky decisions.
    // Unresolved foreground crossings already terminate at the point of loss.
    float reason=leftScreen?6:t<limit?8:!farExit?6:10;
    TraceReason(id.xy,reason,0,stats);
}

// Keep the original Trace entry point untouched. Adding this decision inside
// its loop changed FXC rounding at borderline crossings, including when off.
// Reason 10 proves completed traversal with a far exit and no budget stop.
[numthreads(8,8,1)]
void FinalizeContinuedSky(uint3 id:SV_DispatchThreadID)
{
    if(any(id.xy>=(uint2)_Size.zw))return;
    float4 record=_RecordOutput[id.xy],stats=_TraceInfo[id.xy];
    if(record.w!=0 || stats.x<=0 || _Continuation.x<=0)return;
    bool completed=record.z==10 && ((int)stats.w&8)==0 &&
        stats.x<=_Continuation.x && stats.y<=_Continuation.y && stats.z<=_Continuation.z;
    bool fallback=_EndpointSkyFallback!=0 && ((int)stats.w&1)!=0 &&
        (record.z==8 || (record.z==11 && ((int)stats.w&8)!=0));
    if(!completed && !fallback)return;
    LoadRasterMatrices();
    int2 pixel=min((int2)((id.xy+.5)*_Size.xy/_Size.zw),(int2)_Size.xy-1);
    // Misses retain the original GGX direction. Accepted geometry is untouched.
    float4 guide=_HitOutput[id.xy],rayData=_PointOutput[id.xy];
    float3 start=Position((pixel+.5)/_Size.xy,.5);start*=guide.y/(-start.z);
    float3 direction=rayData.xyz;
    if(direction.z>=0 || !all(isfinite(direction)))return;
    if(fallback && (!all(isfinite(stats)) || !all(isfinite(start)) ||
       guide.y<=_Clip.x || guide.y>=_Clip.y*.999 ||
       mul(transpose((float3x3)rasterView),direction).y<=0))return;
    float distance=(-_Clip.y-start.z)/direction.z;
    float2 endpoint=Project(start+direction*distance);
    if(fallback && (!isfinite(distance) || !all(isfinite(endpoint))))return;
    if(distance<=.05 || any(endpoint<=0) || any(endpoint>=1) ||
       _HiZ0.Load(int3((int2)(endpoint*_Size.xy),0))<_Clip.y*.999)return;
    // Endpoint evidence does not prove the hidden interval is clear. This
    // opt-in inference spends no additional traversal budget or render pass.
    if(fallback && !isfinite(_HiZ0.Load(int3((int2)(endpoint*_Size.xy),0))))return;
    float visibility=1;
    if(rayData.w<1) {
        float3 traceNormal=_Normals.Load(int3(pixel,0)).xyz*2-1;
        traceNormal*=rsqrt(max(dot(traceNormal,traceNormal),1e-12));

        float3 n=normalize(mul((float3x3)rasterView,traceNormal));
        float alpha=(1-rayData.w)*(1-rayData.w),cosine=dot(n,direction);
        if(cosine<=0)return;
        visibility=2*cosine/(cosine+sqrt(alpha*alpha+(1-alpha*alpha)*cosine*cosine));
    }
    float2 border=min(endpoint,1-endpoint)*_Size.xy;
    guide.x=_EdgePixels>0?saturate(min(border.x,border.y)/_EdgePixels):1;
    _HitOutput[id.xy]=guide;
    _RadianceOutput[id.xy]=float4(0,0,0,visibility);
    _RecordOutput[id.xy]=float4(endpoint,distance,2);
    stats.w=(int)stats.w|(fallback?128:64);_TraceInfo[id.xy]=stats;
}
