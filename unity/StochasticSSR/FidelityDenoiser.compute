#pragma kernel Reproject DNSR_REPROJECT
#pragma kernel Prefilter DNSR_PREFILTER
#pragma kernel Accumulate DNSR_ACCUMULATE
#pragma target 5.0

// SM5 uses full precision arithmetic; packing remains explicit 16-bit.
#define min16float float
#define min16float2 float2
#define min16float3 float3
#define min16float4 float4

// D3D11 resource adapter for the pinned AMD headers. Depth is positive eye depth,
// normals are world-space, motion is current UV minus previous UV. Every padded
// lane participates in the AMD group barriers; only stores are bounds checked.
Texture2D<float4> _Input,_Guide,_Point,_Motion,_History,_HistoryGuide,_HistoryPoint,_Surface,_HistorySurface;
Texture2D<float4> _Reprojected,_Average;
Texture2D<float> _Samples,_Variance,_HistorySamples,_HistoryVariance,_Tiles;
Texture2D<float> _CurrentDepth;
SamplerState sampler_linear_clamp;
RWTexture2D<float4> _Output,_OutputAverage;
RWTexture2D<float> _OutputVariance,_OutputSamples;
RWTexture2D<float> _Weight,_OutputTiles;
float4 _Dimensions; // trace xy, camera zw
float4 _Settings; // history valid, maximum samples, smoothness cutoff, temporal enabled
int _InclusiveCutoff,_EfficientDenoising;
groupshared uint tileNeedsFilter;
float4x4 _InvProjection,_ViewToWorld,_WorldToPreviousClip,_PreviousToCurrentView,_Projection;

int2 Bound(int2 p) { return clamp(p,0,(int2)_Dimensions.xy-1); }
bool Inside(int2 p) { return all(p>=0) && all(p<(int2)_Dimensions.xy); }
float3 Decode(float2 p)
{
    float3 n=float3(p,1-abs(p.x)-abs(p.y));
    if(n.z<0)n.xy=(1-abs(n.yx))*float2(n.x>=0?1:-1,n.y>=0?1:-1);
    return normalize(n);
}
float Roughness(float smoothness) { return (1-smoothness)*(1-smoothness); }
bool FFX_DNSR_Reflections_IsGlossyReflection(float r) { return _InclusiveCutoff!=0?r<=Roughness(_Settings.z):r<Roughness(_Settings.z); }
bool FFX_DNSR_Reflections_IsMirrorReflection(float r) { return r<0.0001; }
float3 FFX_DNSR_Reflections_ScreenSpaceToViewSpace(float3 p)
{
    float4 h=mul(_InvProjection,float4(p.xy*2-1,.5,1));
    return h.xyz*(p.z/-h.z);
}
float3 FFX_DNSR_Reflections_ViewSpaceToWorldSpace(float4 p) { return mul(_ViewToWorld,p).xyz; }
float3 FFX_DNSR_Reflections_WorldSpaceToScreenSpacePrevious(float3 p)
{
    float4 h=mul(_WorldToPreviousClip,float4(p,1));
    return h.w>0?float3(h.xy/h.w*.5+.5,h.z/h.w):float3(-1,-1,0);
}
float FFX_DNSR_Reflections_GetLinearDepth(float2 uv,float d) { return max(d,.0001); }
float FFX_DNSR_Reflections_LoadDepth(int2 p) { return _Guide.Load(int3(Bound(p),0)).y; }
min16float FFX_DNSR_Reflections_LoadRoughness(int2 p) { return Roughness(_Point.Load(int3(Bound(p),0)).w); }
float3 HistoryNormal(float2 shade,float2 geometry) { float3 n=Decode(shade),g=Decode(geometry);return normalize(n+(dot(n,g)<0?-g:g)); }
min16float3 FFX_DNSR_Reflections_LoadWorldSpaceNormal(int2 p) {
#if defined(DNSR_REPROJECT)
    return HistoryNormal(_Guide.Load(int3(Bound(p),0)).zw,_Surface.Load(int3(Bound(p),0)).yz);
#else
    return Decode(_Guide.Load(int3(Bound(p),0)).zw);
#endif
}
min16float3 FFX_DNSR_Reflections_LoadRadiance(int2 p) { return _Input.Load(int3(Bound(p),0)).rgb; }
min16float FFX_DNSR_Reflections_LoadRayLength(int2 p)
{
    float3 hit=_Point.Load(int3(Bound(p),0)).xyz;
    float3 receiver=FFX_DNSR_Reflections_ScreenSpaceToViewSpace(float3((Bound(p)+.5)/_Dimensions.xy,FFX_DNSR_Reflections_LoadDepth(p)));
    return hit.z<0?length(hit-receiver):0;
}
float2 FFX_DNSR_Reflections_LoadMotionVector(int2 p) { return _Settings.x>.5?_Motion.Load(int3(Bound(p),0)).xy:float2(2,2); }
min16float3 FFX_DNSR_Reflections_SampleRadianceHistory(float2 uv) { return _Settings.x>.5?_History.SampleLevel(sampler_linear_clamp,uv,0).rgb:0; }
min16float3 FFX_DNSR_Reflections_LoadRadianceHistory(int2 p) { return _Settings.x>.5?_History.Load(int3(Bound(p),0)).rgb:0; }
min16float3 FFX_DNSR_Reflections_SampleWorldSpaceNormalHistory(float2 uv) { return HistoryNormal(_HistoryGuide.SampleLevel(sampler_linear_clamp,uv,0).zw,_HistorySurface.SampleLevel(sampler_linear_clamp,uv,0).yz); }
min16float3 FFX_DNSR_Reflections_LoadWorldSpaceNormalHistory(int2 p) { return HistoryNormal(_HistoryGuide.Load(int3(Bound(p),0)).zw,_HistorySurface.Load(int3(Bound(p),0)).yz); }
float FFX_DNSR_Reflections_SampleDepthHistory(float2 uv) { return _HistoryGuide.SampleLevel(sampler_linear_clamp,uv,0).y; }
float FFX_DNSR_Reflections_LoadDepthHistory(int2 p) { return _HistoryGuide.Load(int3(Bound(p),0)).y; }
min16float FFX_DNSR_Reflections_SampleRoughnessHistory(float2 uv) { return Roughness(_HistoryPoint.SampleLevel(sampler_linear_clamp,uv,0).w); }
min16float FFX_DNSR_Reflections_SampleVarianceHistory(float2 uv) { return _Settings.x>.5?_HistoryVariance.SampleLevel(sampler_linear_clamp,uv,0).r:1; }
min16float FFX_DNSR_Reflections_SampleNumSamplesHistory(float2 uv)
{
    if(_Settings.x<.5)return 0;
    // Extra engine adapter guard: reject a reflected object that disappeared.
    // This validates the old hit, not agreement between independent GGX rays.
    float3 hit=_HistoryPoint.Load(int3(Bound((int2)(uv*_Dimensions.xy)),0)).xyz;
    if(hit.z<0)
    {
        float3 now=mul(_PreviousToCurrentView,float4(hit,1)).xyz;
        float4 clip=mul(_Projection,float4(now,1));
        float2 hitUv=clip.xy/clip.w*.5+.5;
        if(clip.w<=0 || any(hitUv<=0) || any(hitUv>=1))return 0;
        int2 pixel=min((int2)(hitUv*_Dimensions.zw),(int2)_Dimensions.zw-1);
        if(abs(_CurrentDepth.Load(int3(pixel,0))+now.z)>max(.05,abs(now.z)*.01))return 0;
    }
    return _HistorySamples.SampleLevel(sampler_linear_clamp,uv,0).r;
}
min16float FFX_DNSR_Reflections_LoadVariance(int2 p) { return _Variance.Load(int3(Bound(p),0)).r; }
min16float FFX_DNSR_Reflections_LoadNumSamples(int2 p) { return _Samples.Load(int3(Bound(p),0)).r; }
min16float3 FFX_DNSR_Reflections_LoadRadianceReprojected(int2 p) { return _Reprojected.Load(int3(Bound(p),0)).rgb; }
min16float3 FFX_DNSR_Reflections_SampleAverageRadiance(float2 uv) { return _Average.SampleLevel(sampler_linear_clamp,uv,0).rgb; }

void FFX_DNSR_Reflections_StoreRadianceReprojected(int2 p,min16float3 r) { if(Inside(p))_Output[p]=float4(r,1); }
void FFX_DNSR_Reflections_StoreVariance(int2 p,min16float v)
{
    if(!Inside(p))return;
    _OutputVariance[p]=v;
#if defined(DNSR_REPROJECT)
    // This callback only runs for glossy receivers. Match the half packing
    // performed by the upstream prefilter before its variance branch.
    if(_EfficientDenoising!=0 && f16tof32(f32tof16(v))>0 &&
        !FFX_DNSR_Reflections_IsMirrorReflection(FFX_DNSR_Reflections_LoadRoughness(p)))InterlockedOr(tileNeedsFilter,1);
#endif
}
void FFX_DNSR_Reflections_StoreNumSamples(int2 p,min16float n)
{
    if(!Inside(p))return;
#if defined(DNSR_REPROJECT)
    if(_EfficientDenoising!=0)InterlockedOr(tileNeedsFilter,2);
#endif
    n=_Settings.x>.5?min(n,_Settings.y):1;
    _OutputSamples[p]=n;_Weight[p]=_Settings.w>.5?1-rcp(max(n,1)):0;
}
void FFX_DNSR_Reflections_StoreAverageRadiance(int2 p,min16float3 r)
{
    _OutputAverage[p]=float4(r,1);
    // Upstream's reduction barriers have completed all per-pixel callbacks.
    _OutputTiles[p]=tileNeedsFilter;
}
void FFX_DNSR_Reflections_StorePrefilteredReflections(int2 p,min16float3 r,min16float v)
{
    if(Inside(p)) { _Output[p]=float4(r,1);_OutputVariance[p]=v; }
}
void FFX_DNSR_Reflections_StoreTemporalAccumulation(int2 p,min16float3 r,min16float v)
{
    if(Inside(p)) { _Output[p]=float4(r,1);_OutputVariance[p]=v; }
}

#if defined(DNSR_REPROJECT)
#include "AMD/ffx_denoiser_reflections_reproject.h"
[numthreads(8,8,1)]
void Reproject(uint3 id:SV_DispatchThreadID,uint3 local:SV_GroupThreadID)
{
    // Upstream's first group barrier publishes this before store callbacks run.
    if(all(local.xy==0))tileNeedsFilter=0;
    // Non-glossy lanes do not write these resources inside the upstream function.
    if(Inside(id.xy)) { _Output[id.xy]=0;_OutputVariance[id.xy]=1;_OutputSamples[id.xy]=1;_Weight[id.xy]=0; }
    FFX_DNSR_Reflections_Reproject(id.xy,local.xy,(uint2)_Dimensions.xy,.9,(int)_Settings.y);
}
#elif defined(DNSR_PREFILTER)
void FFX_DNSR_Reflections_LoadNeighborhood(int2 p,out min16float3 r,out min16float v,out min16float3 n,out float d,int2 size)
{
    r=FFX_DNSR_Reflections_LoadRadiance(p);v=FFX_DNSR_Reflections_LoadVariance(p);
    n=FFX_DNSR_Reflections_LoadWorldSpaceNormal(p);d=FFX_DNSR_Reflections_LoadDepth(p);
}
#include "AMD/ffx_denoiser_reflections_prefilter.h"
[numthreads(8,8,1)]
void Prefilter(uint3 id:SV_DispatchThreadID,uint3 local:SV_GroupThreadID,uint3 group:SV_GroupID)
{
    // Mask produced during reprojection: no classifier dispatch or group scan.
    // An inactive tile takes exactly upstream's copy-only branch.
    if(_EfficientDenoising!=0 && (((uint)_Tiles.Load(int3(group.xy,0)))&1)==0)
    {
        float3 rgb=f16tof32(f32tof16(FFX_DNSR_Reflections_LoadRadiance(id.xy)));
        float v=f16tof32(f32tof16(FFX_DNSR_Reflections_LoadVariance(id.xy)));
        FFX_DNSR_Reflections_StorePrefilteredReflections(id.xy,rgb,v);return;
    }
    FFX_DNSR_Reflections_Prefilter(id.xy,local.xy,(uint2)_Dimensions.xy);
}
#elif defined(DNSR_ACCUMULATE)
#include "AMD/ffx_denoiser_reflections_resolve_temporal.h"
[numthreads(8,8,1)]
void Accumulate(uint3 id:SV_DispatchThreadID,uint3 local:SV_GroupThreadID,uint3 group:SV_GroupID)
{
    // Uniform for all 64 lanes, including the padded lanes of partial tiles.
    if(_EfficientDenoising!=0 && (((uint)_Tiles.Load(int3(group.xy,0)))&2)==0)
    {
        float3 rgb=f16tof32(f32tof16(FFX_DNSR_Reflections_LoadRadiance(id.xy)));
        FFX_DNSR_Reflections_StoreTemporalAccumulation(id.xy,rgb,FFX_DNSR_Reflections_LoadVariance(id.xy));return;
    }
    FFX_DNSR_Reflections_ResolveTemporal(id.xy,local.xy,(uint2)_Dimensions.xy,1/_Dimensions.xy,1.0);
}
#endif
